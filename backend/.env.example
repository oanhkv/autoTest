# Sao chép file này thành .env rồi điền giá trị.

# === Nguồn AI: "gemini" (miễn phí, nhanh) | "ollama" (local) | "anthropic" (trả phí) ===
PROVIDER=gemini

# --- Khi PROVIDER=gemini (KHUYẾN NGHỊ: miễn phí, nhanh, có Vision) ---
# Lấy key miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.5-flash-lite: free tier hạn mức cao, nhanh. (gemini-2.5-flash chất lượng nhỉnh hơn nhưng quota/ngày thấp)
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Khi PROVIDER=ollama (chạy local, cần máy mạnh) ---
# OLLAMA_MODEL=qwen2.5:1.5b
# OLLAMA_HOST=http://localhost:11434

# --- Khi PROVIDER=anthropic (Claude API, trả phí riêng) ---
# ANTHROPIC_API_KEY=sk-ant-xxxx
# CLAUDE_MODEL=claude-sonnet-4-6
