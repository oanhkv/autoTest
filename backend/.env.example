# Sao chép file này thành .env rồi điền giá trị.

# === Nguồn AI: "gemini" (miễn phí, nhanh) | "ollama" (local) | "anthropic" (trả phí) ===
PROVIDER=gemini

# "local": chạy test không gọi thêm AI/không tốn quota (khuyến nghị).
# "ai": dùng AI lập kế hoạch; nếu API lỗi sẽ tự fallback về local.
AUTOTEST_PLAN_MODE=local

# --- Khi PROVIDER=gemini (KHUYẾN NGHỊ: miễn phí, nhanh, có Vision) ---
# Lấy key miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.5-flash-lite: free tier hạn mức cao, nhanh. (gemini-2.5-flash chất lượng nhỉnh hơn nhưng quota/ngày thấp)
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Khi PROVIDER=ollama (chạy local, cần máy mạnh) ---
# OLLAMA_MODEL=qwen2.5:1.5b
# OLLAMA_HOST=http://localhost:11434

# --- Khi PROVIDER=anthropic (Claude API, trả phí riêng) ---
# ANTHROPIC_API_KEY=sk-ant-xxxx
# CLAUDE_MODEL=claude-sonnet-4-6

# === Bảo mật backend (xem backend/security.py) ===
# Mặc định chỉ extension Chrome + localhost được gọi backend; trang web lạ bị chặn (403).
# (Tùy chọn) Bật token: đặt chuỗi bí mật bất kỳ, rồi dán cùng giá trị vào ô "Token" ở chân extension.
# AUTOTEST_TOKEN=
# (Tùy chọn) Chỉ cho đúng 1 extension (ID xem ở chrome://extensions):
# AUTOTEST_EXTENSION_ID=
# (Tùy chọn) Thêm origin khác, phân cách dấu phẩy:
# AUTOTEST_ALLOWED_ORIGINS=
